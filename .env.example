# Copy to .env.local and fill in. NEVER commit real values.
# These are read only by the serverless functions in /api — never by the frontend.

# AI provider (OpenAI-compatible; e.g. DeepSeek)
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat            # use whatever model is current/best-value

# Per-user spend caps ("user" = client IP; the tool is login-free).
RATE_LIMIT_PER_MIN=10             # burst limit
RATE_LIMIT_PER_DAY=100            # coach requests per person per day
TOKEN_BUDGET_PER_DAY=60000        # tokens per person per day
MAX_INPUT_CHARS=6000              # reject oversized sections before they cost anything

# Site-wide daily ceiling, so one bad day can't drain the account.
SITE_TOKEN_BUDGET_PER_DAY=2000000

# NOTE: these counters are in-memory, so they reset when a serverless instance
# recycles and are not shared across instances. They are a cost dampener, not an
# airtight quota. Always also set a hard spend limit on the provider account.
