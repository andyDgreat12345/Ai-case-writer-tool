# Copy to .env.local and fill in. NEVER commit real values.
# These are read only by the serverless functions in /api — never by the frontend.

# AI provider (OpenAI-compatible; e.g. DeepSeek)
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat            # use whatever model is current/best-value

# Per-user spend caps ("user" = client IP; the tool is login-free).
RATE_LIMIT_PER_MIN=10             # burst limit
RATE_LIMIT_PER_DAY=100            # coach requests per person per day
TOKEN_BUDGET_PER_DAY=60000        # tokens per person per day
MAX_INPUT_CHARS=6000              # reject oversized sections before they cost anything

# Site-wide daily ceiling, so one bad day can't drain the account.
SITE_TOKEN_BUDGET_PER_DAY=2000000

# --- Making the caps actually bind -------------------------------------------
# Without a shared store the counters live in the serverless instance. Measured
# on Vercel, consecutive requests land on FRESH instances, so the daily counter
# resets almost every call and the daily cap does not meaningfully bind.
#
# Set these two and the caps are enforced for real, across every request:
#   1. Create a free Upstash Redis database (no card needed for the free tier).
#   2. Copy its REST URL and REST token here / into the host dashboard.
# Leave them unset and the app still works — it just falls back to the weak
# in-memory counters, and the UI hides the "requests left" badge rather than
# showing a number that isn't real.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Either way, the only HARD ceiling on spend is the limit you set on the AI
# provider account itself. Set one.

# --- Public deployments -------------------------------------------------------
# The code is open source, so the API shape is public. Without this, anyone can
# point their own page at your deployment and spend your provider credit.
# Comma-separated origins allowed to call /api. Leave unset to disable the check
# (fine for local dev and private instances).
ALLOWED_ORIGINS=https://your-site.vercel.app
